# Paths engram backs up for this checkout. Each one is ignored by git, so
# without this file it would exist only on this disk. List only what git
# doesn't hold: no caches, build output or task outputs.

# Internal designs, investigations, audits, research and ledgers.
.cortexkit/internal-docs/

# Head working material: worker briefs, spec drafts, plans, review and audit
# records, and rig setup. The folder is moving from `alfonso` to `prefrontal`;
# both are listed until the move is done, and Engram skips whichever is absent.
.cortexkit/prefrontal/prompts/
.cortexkit/prefrontal/drafts/
.cortexkit/prefrontal/plans/
.cortexkit/prefrontal/specs/
.cortexkit/prefrontal/audit/
.cortexkit/prefrontal/review/
.cortexkit/prefrontal/rigs/
.cortexkit/alfonso/prompts/
.cortexkit/alfonso/drafts/
.cortexkit/alfonso/plans/
.cortexkit/alfonso/specs/
.cortexkit/alfonso/audit/
.cortexkit/alfonso/review/
.cortexkit/alfonso/rigs/

# Local agent and campaign configuration.
.cortexkit/prefrontal.jsonc
.cortexkit/alfonso.jsonc
.cortexkit/campaign-lab.jsonc
.cortexkit/campaign-packs/
