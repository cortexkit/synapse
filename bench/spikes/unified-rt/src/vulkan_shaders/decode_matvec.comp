#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require

#extension GL_KHR_shader_subgroup_basic : require

// Wave 4 seam 3: four independent serial f16 rows per subgroup, mirroring the
// Q8 pack-four mechanism that wave 3 measured at +140% Q8. One invocation owns
// one output row, so every f32 dot-product accumulation still follows a fixed
// left-to-right order; no subgroup reduction combines partials of a single dot.
// The fixed 64-invocation workgroup handles both RDNA3 wave32 (two four-row
// subgroups) and wave64 (one four-row subgroup) via gl_SubgroupSize.
//
// Weights and activations are read as uvec2 (four halves per 8-byte load) and
// expanded with unpackHalf2x16, which widens each half to f32 exactly like the
// scalar float(half) conversion. Products are formed in f32 and added in
// ascending column order, so the dot stays bit-identical to the scalar wave-1
// kernel. Columns are a multiple of four for every Qwen3 matvec (hidden 1024,
// intermediate 3072), matching the Q8 shader's no-tail convention.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, scalar) readonly buffer Input { uvec2 values[]; } input_values;
layout(set = 0, binding = 1, scalar) readonly buffer Weight { uvec2 values[]; } weight_values;
layout(set = 0, binding = 2, scalar) writeonly buffer Output { float values[]; } output_values;
layout(push_constant) uniform Params { uint rows; uint columns; uint unused0; uint unused1; } p;

void main() {
    uint subgroups_per_workgroup = 64u / gl_SubgroupSize;
    uint subgroup = gl_WorkGroupID.x * subgroups_per_workgroup + gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    if (lane >= 4u) return;

    uint row = subgroup * 4u + lane;
    if (row >= p.rows) return;
    float sum = 0.0;
    uint vecs = p.columns >> 2;          // four halves per uvec2
    uint base = row * vecs;
    for (uint v = 0; v < vecs; ++v) {
        uvec2 weight = weight_values.values[base + v];
        uvec2 xv = input_values.values[v];
        vec2 w01 = unpackHalf2x16(weight.x);
        vec2 w23 = unpackHalf2x16(weight.y);
        vec2 x01 = unpackHalf2x16(xv.x);
        vec2 x23 = unpackHalf2x16(xv.y);
        sum += w01.x * x01.x;
        sum += w01.y * x01.y;
        sum += w23.x * x23.x;
        sum += w23.y * x23.y;
    }
    output_values.values[row] = sum;
}
