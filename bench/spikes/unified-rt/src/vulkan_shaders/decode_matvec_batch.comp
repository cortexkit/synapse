#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require

#extension GL_KHR_shader_subgroup_basic : require

// Wave 5 batched mat-mat: one weight-row read feeds K column dot products.
// This is the Vulkan port of the Metal batched-verify mat-mat kernels
// (BATCHED-VERIFY.md). The column count K is a SPECIALIZATION CONSTANT so the
// driver specializes it at pipeline creation; the K accumulators stay
// register-resident and each column's `sums[k] += ...` chain preserves the
// exact ascending order of the K=1 decode_matvec shader. A runtime column
// count would spill the accumulators to memory and let the compiler fold the
// four products of a uvec2 before adding them to the running sum — a
// reordering that breaks the byte-exact gate (the same failure the Metal
// template instantiation fixed).
//
// The accumulators are declared as explicit scalars per K branch (not an
// array indexed by a loop variable) so the glslc compiler keeps them in
// registers and preserves the single-token accumulation order. An array
// `float sums[K]` even with K specialized lets the compiler reorder the
// products within one uvec2 group before adding them to the running sum.
//
// The fixed 64-invocation workgroup handles both RDNA3 wave32 (two four-row
// subgroups) and wave64 (one four-row subgroup) via gl_SubgroupSize. Four
// independent invocations in each subgroup own four complete output rows;
// every row's K dot products remain serial left-to-right f32 accumulations.
//
// Exactness law: batching parallelizes ACROSS K columns (independent
// reductions); it never reorders the accumulation WITHIN one dot product.
// Column k's dot is bit-identical to decode_matvec applied to column k's
// activation, because the weight is walked in the same ascending uvec2 order
// and the four products per uvec2 are added in the same order.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, scalar) readonly buffer Input { uvec2 values[]; } input_values;
layout(set = 0, binding = 1, scalar) readonly buffer Weight { uvec2 values[]; } weight_values;
layout(set = 0, binding = 2, scalar) writeonly buffer Output { float values[]; } output_values;
layout(push_constant) uniform Params { uint rows; uint columns; uint batch; uint unused; } p;

layout(constant_id = 0) const uint K = 1;

void main() {
    uint subgroups_per_workgroup = 64u / gl_SubgroupSize;
    uint subgroup = gl_WorkGroupID.x * subgroups_per_workgroup + gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    if (lane >= 4u) return;

    uint row = subgroup * 4u + lane;
    if (row >= p.rows) return;

    uint vecs = p.columns >> 2;          // four halves per uvec2
    uint base = row * vecs;

    // Declare accumulators as explicit scalars per K branch so the compiler
    // keeps them in registers indexed by constants (not an array indexed by
    // a loop variable, which the compiler may spill and reorder).
    float s0 = 0.0;
    float s1 = 0.0;
    float s2 = 0.0;
    float s3 = 0.0;
    float s4 = 0.0;
    float s5 = 0.0;
    float s6 = 0.0;
    float s7 = 0.0;
    float s8 = 0.0;
    float s9 = 0.0;
    float s10 = 0.0;
    float s11 = 0.0;
    float s12 = 0.0;
    float s13 = 0.0;
    float s14 = 0.0;
    float s15 = 0.0;

    for (uint v = 0; v < vecs; ++v) {
        uvec2 weight = weight_values.values[base + v];
        vec2 w01 = unpackHalf2x16(weight.x);
        vec2 w23 = unpackHalf2x16(weight.y);
        if (K >= 1) {
            uvec2 xv = input_values.values[0 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s0 += w01.x * x01.x;
            s0 += w01.y * x01.y;
            s0 += w23.x * x23.x;
            s0 += w23.y * x23.y;
        }
        if (K >= 2) {
            uvec2 xv = input_values.values[1 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s1 += w01.x * x01.x;
            s1 += w01.y * x01.y;
            s1 += w23.x * x23.x;
            s1 += w23.y * x23.y;
        }
        if (K >= 3) {
            uvec2 xv = input_values.values[2 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s2 += w01.x * x01.x;
            s2 += w01.y * x01.y;
            s2 += w23.x * x23.x;
            s2 += w23.y * x23.y;
        }
        if (K >= 4) {
            uvec2 xv = input_values.values[3 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s3 += w01.x * x01.x;
            s3 += w01.y * x01.y;
            s3 += w23.x * x23.x;
            s3 += w23.y * x23.y;
        }
        if (K >= 5) {
            uvec2 xv = input_values.values[4 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s4 += w01.x * x01.x;
            s4 += w01.y * x01.y;
            s4 += w23.x * x23.x;
            s4 += w23.y * x23.y;
        }
        if (K >= 6) {
            uvec2 xv = input_values.values[5 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s5 += w01.x * x01.x;
            s5 += w01.y * x01.y;
            s5 += w23.x * x23.x;
            s5 += w23.y * x23.y;
        }
        if (K >= 7) {
            uvec2 xv = input_values.values[6 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s6 += w01.x * x01.x;
            s6 += w01.y * x01.y;
            s6 += w23.x * x23.x;
            s6 += w23.y * x23.y;
        }
        if (K >= 8) {
            uvec2 xv = input_values.values[7 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s7 += w01.x * x01.x;
            s7 += w01.y * x01.y;
            s7 += w23.x * x23.x;
            s7 += w23.y * x23.y;
        }
        if (K >= 9) {
            uvec2 xv = input_values.values[8 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s8 += w01.x * x01.x;
            s8 += w01.y * x01.y;
            s8 += w23.x * x23.x;
            s8 += w23.y * x23.y;
        }
        if (K >= 10) {
            uvec2 xv = input_values.values[9 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s9 += w01.x * x01.x;
            s9 += w01.y * x01.y;
            s9 += w23.x * x23.x;
            s9 += w23.y * x23.y;
        }
        if (K >= 11) {
            uvec2 xv = input_values.values[10 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s10 += w01.x * x01.x;
            s10 += w01.y * x01.y;
            s10 += w23.x * x23.x;
            s10 += w23.y * x23.y;
        }
        if (K >= 12) {
            uvec2 xv = input_values.values[11 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s11 += w01.x * x01.x;
            s11 += w01.y * x01.y;
            s11 += w23.x * x23.x;
            s11 += w23.y * x23.y;
        }
        if (K >= 13) {
            uvec2 xv = input_values.values[12 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s12 += w01.x * x01.x;
            s12 += w01.y * x01.y;
            s12 += w23.x * x23.x;
            s12 += w23.y * x23.y;
        }
        if (K >= 14) {
            uvec2 xv = input_values.values[13 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s13 += w01.x * x01.x;
            s13 += w01.y * x01.y;
            s13 += w23.x * x23.x;
            s13 += w23.y * x23.y;
        }
        if (K >= 15) {
            uvec2 xv = input_values.values[14 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s14 += w01.x * x01.x;
            s14 += w01.y * x01.y;
            s14 += w23.x * x23.x;
            s14 += w23.y * x23.y;
        }
        if (K >= 16) {
            uvec2 xv = input_values.values[15 * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s15 += w01.x * x01.x;
            s15 += w01.y * x01.y;
            s15 += w23.x * x23.x;
            s15 += w23.y * x23.y;
        }
    }

    if (K >= 1 && 0 < p.batch) output_values.values[0 * p.rows + row] = s0;
    if (K >= 2 && 1 < p.batch) output_values.values[1 * p.rows + row] = s1;
    if (K >= 3 && 2 < p.batch) output_values.values[2 * p.rows + row] = s2;
    if (K >= 4 && 3 < p.batch) output_values.values[3 * p.rows + row] = s3;
    if (K >= 5 && 4 < p.batch) output_values.values[4 * p.rows + row] = s4;
    if (K >= 6 && 5 < p.batch) output_values.values[5 * p.rows + row] = s5;
    if (K >= 7 && 6 < p.batch) output_values.values[6 * p.rows + row] = s6;
    if (K >= 8 && 7 < p.batch) output_values.values[7 * p.rows + row] = s7;
    if (K >= 9 && 8 < p.batch) output_values.values[8 * p.rows + row] = s8;
    if (K >= 10 && 9 < p.batch) output_values.values[9 * p.rows + row] = s9;
    if (K >= 11 && 10 < p.batch) output_values.values[10 * p.rows + row] = s10;
    if (K >= 12 && 11 < p.batch) output_values.values[11 * p.rows + row] = s11;
    if (K >= 13 && 12 < p.batch) output_values.values[12 * p.rows + row] = s12;
    if (K >= 14 && 13 < p.batch) output_values.values[13 * p.rows + row] = s13;
    if (K >= 15 && 14 < p.batch) output_values.values[14 * p.rows + row] = s14;
    if (K >= 16 && 15 < p.batch) output_values.values[15 * p.rows + row] = s15;
}