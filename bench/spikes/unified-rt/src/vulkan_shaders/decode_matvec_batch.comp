#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require

#extension GL_KHR_shader_subgroup_basic : require

// Wave 5 batched mat-mat: one weight-row read feeds K column dot products.
// This is the Vulkan port of the Metal batched-verify mat-mat kernels
// (BATCHED-VERIFY.md). The column count K is a SPECIALIZATION CONSTANT so the
// driver specializes it at pipeline creation; the K accumulators stay
// register-resident and each column's `sums[k] += ...` chain preserves the
// exact ascending order of the K=1 decode_matvec shader. A runtime column
// count would spill the accumulators to memory and let the compiler fold the
// four products of a uvec2 before adding them to the running sum — a
// reordering that breaks the byte-exact gate (the same failure the Metal
// template instantiation fixed).
//
// The accumulators are declared as explicit scalars per 16-column chunk (not
// an array indexed by a loop variable) so glslc keeps each dot's accumulator
// in a register and preserves the single-token accumulation order. Larger
// specializations repeat this explicit chunk over K; they trade a second
// weight-row read for bounded register pressure rather than spilling 64 sums.
//
// The fixed 64-invocation workgroup handles both RDNA3 wave32 (two four-row
// subgroups) and wave64 (one four-row subgroup) via gl_SubgroupSize. Four
// independent invocations in each subgroup own four complete output rows;
// every row's K dot products remain serial left-to-right f32 accumulations.
//
// Exactness law: batching parallelizes ACROSS K columns (independent
// reductions); it never reorders the accumulation WITHIN one dot product.
// Column k's dot is bit-identical to decode_matvec applied to column k's
// activation, because the weight is walked in the same ascending uvec2 order
// and the four products per uvec2 are added in the same order.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, scalar) readonly buffer Input { uvec2 values[]; } input_values;
layout(set = 0, binding = 1, scalar) readonly buffer Weight { uvec2 values[]; } weight_values;
layout(set = 0, binding = 2, scalar) writeonly buffer Output { float values[]; } output_values;
layout(push_constant) uniform Params { uint rows; uint columns; uint batch; uint unused; } p;

layout(constant_id = 0) const uint K = 1;

void main() {
    uint subgroups_per_workgroup = 64u / gl_SubgroupSize;
    uint subgroup = gl_WorkGroupID.x * subgroups_per_workgroup + gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    if (lane >= 4u) return;

    uint row = subgroup * 4u + lane;
    if (row >= p.rows) return;

    uint vecs = p.columns >> 2;          // four halves per uvec2
    uint base = row * vecs;

    // K=32 and K=64 use repeated explicit 16-column chunks. The runtime batch
    // guard prevents a rounded specialization from reading or writing padding.
    for (uint chunk = 0u; chunk < K; chunk += 16u) {
      // Reset each chunk's explicit accumulators before walking the weights.
      float s0 = 0.0;
      float s1 = 0.0;
      float s2 = 0.0;
      float s3 = 0.0;
      float s4 = 0.0;
      float s5 = 0.0;
      float s6 = 0.0;
      float s7 = 0.0;
      float s8 = 0.0;
      float s9 = 0.0;
      float s10 = 0.0;
      float s11 = 0.0;
      float s12 = 0.0;
      float s13 = 0.0;
      float s14 = 0.0;
      float s15 = 0.0;

      for (uint v = 0; v < vecs; ++v) {
        uvec2 weight = weight_values.values[base + v];
        vec2 w01 = unpackHalf2x16(weight.x);
        vec2 w23 = unpackHalf2x16(weight.y);
        if (chunk + 0u < p.batch && K >= 1u) {
            uvec2 xv = input_values.values[(chunk + 0u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s0 += w01.x * x01.x;
            s0 += w01.y * x01.y;
            s0 += w23.x * x23.x;
            s0 += w23.y * x23.y;
        }
        if (chunk + 1u < p.batch && K >= 2u) {
            uvec2 xv = input_values.values[(chunk + 1u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s1 += w01.x * x01.x;
            s1 += w01.y * x01.y;
            s1 += w23.x * x23.x;
            s1 += w23.y * x23.y;
        }
        if (chunk + 2u < p.batch && K >= 3u) {
            uvec2 xv = input_values.values[(chunk + 2u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s2 += w01.x * x01.x;
            s2 += w01.y * x01.y;
            s2 += w23.x * x23.x;
            s2 += w23.y * x23.y;
        }
        if (chunk + 3u < p.batch && K >= 4u) {
            uvec2 xv = input_values.values[(chunk + 3u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s3 += w01.x * x01.x;
            s3 += w01.y * x01.y;
            s3 += w23.x * x23.x;
            s3 += w23.y * x23.y;
        }
        if (chunk + 4u < p.batch && K >= 5u) {
            uvec2 xv = input_values.values[(chunk + 4u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s4 += w01.x * x01.x;
            s4 += w01.y * x01.y;
            s4 += w23.x * x23.x;
            s4 += w23.y * x23.y;
        }
        if (chunk + 5u < p.batch && K >= 6u) {
            uvec2 xv = input_values.values[(chunk + 5u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s5 += w01.x * x01.x;
            s5 += w01.y * x01.y;
            s5 += w23.x * x23.x;
            s5 += w23.y * x23.y;
        }
        if (chunk + 6u < p.batch && K >= 7u) {
            uvec2 xv = input_values.values[(chunk + 6u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s6 += w01.x * x01.x;
            s6 += w01.y * x01.y;
            s6 += w23.x * x23.x;
            s6 += w23.y * x23.y;
        }
        if (chunk + 7u < p.batch && K >= 8u) {
            uvec2 xv = input_values.values[(chunk + 7u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s7 += w01.x * x01.x;
            s7 += w01.y * x01.y;
            s7 += w23.x * x23.x;
            s7 += w23.y * x23.y;
        }
        if (chunk + 8u < p.batch && K >= 9u) {
            uvec2 xv = input_values.values[(chunk + 8u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s8 += w01.x * x01.x;
            s8 += w01.y * x01.y;
            s8 += w23.x * x23.x;
            s8 += w23.y * x23.y;
        }
        if (chunk + 9u < p.batch && K >= 10u) {
            uvec2 xv = input_values.values[(chunk + 9u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s9 += w01.x * x01.x;
            s9 += w01.y * x01.y;
            s9 += w23.x * x23.x;
            s9 += w23.y * x23.y;
        }
        if (chunk + 10u < p.batch && K >= 11u) {
            uvec2 xv = input_values.values[(chunk + 10u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s10 += w01.x * x01.x;
            s10 += w01.y * x01.y;
            s10 += w23.x * x23.x;
            s10 += w23.y * x23.y;
        }
        if (chunk + 11u < p.batch && K >= 12u) {
            uvec2 xv = input_values.values[(chunk + 11u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s11 += w01.x * x01.x;
            s11 += w01.y * x01.y;
            s11 += w23.x * x23.x;
            s11 += w23.y * x23.y;
        }
        if (chunk + 12u < p.batch && K >= 13u) {
            uvec2 xv = input_values.values[(chunk + 12u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s12 += w01.x * x01.x;
            s12 += w01.y * x01.y;
            s12 += w23.x * x23.x;
            s12 += w23.y * x23.y;
        }
        if (chunk + 13u < p.batch && K >= 14u) {
            uvec2 xv = input_values.values[(chunk + 13u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s13 += w01.x * x01.x;
            s13 += w01.y * x01.y;
            s13 += w23.x * x23.x;
            s13 += w23.y * x23.y;
        }
        if (chunk + 14u < p.batch && K >= 15u) {
            uvec2 xv = input_values.values[(chunk + 14u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s14 += w01.x * x01.x;
            s14 += w01.y * x01.y;
            s14 += w23.x * x23.x;
            s14 += w23.y * x23.y;
        }
        if (chunk + 15u < p.batch && K >= 16u) {
            uvec2 xv = input_values.values[(chunk + 15u) * vecs + v];
            vec2 x01 = unpackHalf2x16(xv.x);
            vec2 x23 = unpackHalf2x16(xv.y);
            s15 += w01.x * x01.x;
            s15 += w01.y * x01.y;
            s15 += w23.x * x23.x;
            s15 += w23.y * x23.y;
        }
    }

      if (K >= 1 && chunk + 0u < p.batch) output_values.values[(chunk + 0u) * p.rows + row] = s0;
      if (K >= 2 && chunk + 1u < p.batch) output_values.values[(chunk + 1u) * p.rows + row] = s1;
      if (K >= 3 && chunk + 2u < p.batch) output_values.values[(chunk + 2u) * p.rows + row] = s2;
      if (K >= 4 && chunk + 3u < p.batch) output_values.values[(chunk + 3u) * p.rows + row] = s3;
      if (K >= 5 && chunk + 4u < p.batch) output_values.values[(chunk + 4u) * p.rows + row] = s4;
      if (K >= 6 && chunk + 5u < p.batch) output_values.values[(chunk + 5u) * p.rows + row] = s5;
      if (K >= 7 && chunk + 6u < p.batch) output_values.values[(chunk + 6u) * p.rows + row] = s6;
      if (K >= 8 && chunk + 7u < p.batch) output_values.values[(chunk + 7u) * p.rows + row] = s7;
      if (K >= 9 && chunk + 8u < p.batch) output_values.values[(chunk + 8u) * p.rows + row] = s8;
      if (K >= 10 && chunk + 9u < p.batch) output_values.values[(chunk + 9u) * p.rows + row] = s9;
      if (K >= 11 && chunk + 10u < p.batch) output_values.values[(chunk + 10u) * p.rows + row] = s10;
      if (K >= 12 && chunk + 11u < p.batch) output_values.values[(chunk + 11u) * p.rows + row] = s11;
      if (K >= 13 && chunk + 12u < p.batch) output_values.values[(chunk + 12u) * p.rows + row] = s12;
      if (K >= 14 && chunk + 13u < p.batch) output_values.values[(chunk + 13u) * p.rows + row] = s13;
      if (K >= 15 && chunk + 14u < p.batch) output_values.values[(chunk + 14u) * p.rows + row] = s14;
      if (K >= 16 && chunk + 15u < p.batch) output_values.values[(chunk + 15u) * p.rows + row] = s15;
      }
}