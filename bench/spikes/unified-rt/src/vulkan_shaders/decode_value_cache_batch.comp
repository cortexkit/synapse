#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require

// Wave 5 batched value-cache write: writes K columns of V into cache slots
// position..position+K-1. Each invocation handles one (column, element) pair.
// The cache layout is [position][kv_heads * head_dim], so column k writes to
// slot (p.position + k).
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, scalar) readonly buffer Input { float values[]; } input_values;
layout(set = 0, binding = 1, scalar) writeonly buffer Cache { float16_t values[]; } cache_values;
layout(push_constant) uniform Params { uint count; uint position; uint batch; uint unused; } p;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= p.count) return;
    for (uint k = 0; k < p.batch; ++k) {
        cache_values.values[(p.position + k) * p.count + index] =
            float16_t(input_values.values[k * p.count + index]);
    }
}