#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require
layout(local_size_x = 256) in;
layout(set=0,binding=0,scalar) readonly buffer Scores { float values[]; } scores;
layout(set=0,binding=1,scalar) readonly buffer PaddingMask { uint values[]; } padding_mask;
layout(set=0,binding=2,scalar) readonly buffer BandMask { float values[]; } band_mask;
layout(set=0,binding=3,scalar) writeonly buffer Output { float16_t values[]; } output_values;
layout(push_constant) uniform Params { uint batch; uint heads; uint seq; float scale; uint sliding; } p;
shared float reduced[256];
float masked_value(uint row, uint column) {
    uint batch_index = row / (p.heads * p.seq);
    float mask = padding_mask.values[batch_index * p.seq + column] != 0 ? 0.0 : -10000.0;
    if (p.sliding != 0) mask = min(mask, band_mask.values[(row % p.seq) * p.seq + column]);
    return scores.values[row * p.seq + column] * p.scale + mask;
}
void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    float maximum = -3.402823e38;
    for (uint column = lane; column < p.seq; column += 256) maximum = max(maximum, masked_value(row, column));
    reduced[lane] = maximum; barrier();
    for (uint step = 128; step > 0; step >>= 1) { if (lane < step) reduced[lane] = max(reduced[lane], reduced[lane + step]); barrier(); }
    maximum = reduced[0];
    float sum = 0.0;
    for (uint column = lane; column < p.seq; column += 256) sum += exp(masked_value(row, column) - maximum);
    reduced[lane] = sum; barrier();
    for (uint step = 128; step > 0; step >>= 1) { if (lane < step) reduced[lane] += reduced[lane + step]; barrier(); }
    float inverse = 1.0 / max(reduced[0], 1e-20);
    for (uint column = lane; column < p.seq; column += 256) output_values.values[row * p.seq + column] = float16_t(exp(masked_value(row, column) - maximum) * inverse);
}
