#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require
layout(local_size_x = 256) in;
layout(set=0,binding=0,scalar) readonly buffer Scores { float values[]; } scores;
layout(set=0,binding=1,scalar) readonly buffer Mask { uint values[]; } mask;
layout(set=0,binding=2,scalar) writeonly buffer Output { float16_t values[]; } output_values;
layout(push_constant) uniform Params { uint batch; uint kv_heads; uint seq; float scale; } p;
shared float reduced[256];
float value_at(uint row, uint column) {
    uint matrix = row / p.seq;
    uint batch_index = (matrix / p.kv_heads) % p.batch;
    uint query = row % p.seq;
    return column > query || mask.values[batch_index * p.seq + column] == 0 ? -10000.0 : scores.values[row * p.seq + column] * p.scale;
}
void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    float maximum = -3.402823e38;
    for (uint column = lane; column < p.seq; column += 256) maximum = max(maximum, value_at(row, column));
    reduced[lane] = maximum; barrier();
    for (uint step = 128; step > 0; step >>= 1) { if (lane < step) reduced[lane] = max(reduced[lane], reduced[lane + step]); barrier(); }
    maximum = reduced[0];
    float sum = 0.0;
    for (uint column = lane; column < p.seq; column += 256) sum += exp(value_at(row, column) - maximum);
    reduced[lane] = sum; barrier();
    for (uint step = 128; step > 0; step >>= 1) { if (lane < step) reduced[lane] += reduced[lane + step]; barrier(); }
    float inverse = 1.0 / max(reduced[0], 1e-20);
    for (uint column = lane; column < p.seq; column += 256) output_values.values[row * p.seq + column] = float16_t(exp(value_at(row, column) - maximum) * inverse);
}
