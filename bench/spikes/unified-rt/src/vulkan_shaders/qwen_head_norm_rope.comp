#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require
layout(local_size_x = 256) in;
layout(set=0,binding=0,scalar) readonly buffer Input { float values[]; } input_values;
layout(set=0,binding=1,scalar) readonly buffer Weight { float values[]; } weight_values;
layout(set=0,binding=2,scalar) readonly buffer Cosine { float values[]; } cosine;
layout(set=0,binding=3,scalar) readonly buffer Sine { float values[]; } sine;
layout(set=0,binding=4,scalar) writeonly buffer Output { float16_t values[]; } output_values;
layout(push_constant) uniform Params { uint batch; uint seq; uint heads; uint head_dim; float epsilon; uint groups; } p;
shared float squares[256];
void main() {
    uint row_head = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    uint head = row_head % p.heads;
    uint row = row_head / p.heads;
    uint position = row % p.seq;
    uint batch_index = row / p.seq;
    uint source = row * p.heads * p.head_dim + head * p.head_dim;
    float square = 0.0;
    for (uint dimension = lane; dimension < p.head_dim; dimension += 256) { float value = input_values.values[source + dimension]; square += value * value; }
    squares[lane] = square; barrier();
    for (uint step = 128; step > 0; step >>= 1) { if (lane < step) squares[lane] += squares[lane + step]; barrier(); }
    float inverse = inversesqrt(squares[0] / float(p.head_dim) + p.epsilon);
    uint kv_heads = p.heads / p.groups;
    uint group = head % p.groups;
    uint kv_head = head / p.groups;
    uint target = ((group * p.batch * kv_heads + batch_index * kv_heads + kv_head) * p.seq + position) * p.head_dim;
    uint half_dim = p.head_dim / 2;
    for (uint dimension = lane; dimension < p.head_dim; dimension += 256) {
        uint pair = dimension < half_dim ? dimension + half_dim : dimension - half_dim;
        float value = input_values.values[source + dimension] * inverse * weight_values.values[dimension];
        float pair_value = input_values.values[source + pair] * inverse * weight_values.values[pair];
        float sign_value = dimension < half_dim ? -1.0 : 1.0;
        output_values.values[target + dimension] = float16_t(value * cosine.values[position * p.head_dim + dimension] + sign_value * pair_value * sine.values[position * p.head_dim + dimension]);
    }
}
