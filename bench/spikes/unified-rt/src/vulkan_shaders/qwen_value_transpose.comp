#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require
layout(local_size_x = 256) in;
layout(set=0,binding=0,scalar) readonly buffer Input { float values[]; } input_values;
layout(set=0,binding=1,scalar) writeonly buffer Output { float16_t values[]; } output_values;
layout(push_constant) uniform Params { uint batch; uint seq; uint heads; uint head_dim; } p;
void main() {
    uint index = gl_GlobalInvocationID.x;
    uint total = p.batch * p.seq * p.heads * p.head_dim;
    if (index >= total) return;
    uint dimension = index % p.head_dim;
    uint remainder = index / p.head_dim;
    uint head = remainder % p.heads; remainder /= p.heads;
    uint position = remainder % p.seq;
    uint batch_index = remainder / p.seq;
    uint target = ((batch_index * p.heads + head) * p.seq + position) * p.head_dim + dimension;
    output_values.values[target] = float16_t(input_values.values[index]);
}
