#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require
layout(local_size_x = 256) in;
layout(set=0,binding=0,scalar) readonly buffer Projected { float values[]; } projected;
layout(set=0,binding=1,scalar) readonly buffer Bias { float16_t values[]; } bias_values;
layout(set=0,binding=2,scalar) readonly buffer Residual { float16_t values[]; } residual;
layout(set=0,binding=3,scalar) readonly buffer Weight { float values[]; } weight_values;
layout(set=0,binding=4,scalar) readonly buffer NormBias { float values[]; } norm_bias;
layout(set=0,binding=5,scalar) writeonly buffer Output { float16_t values[]; } output_values;
layout(push_constant) uniform Params { uint rows; uint hidden; float epsilon; } p;
shared float sums[256];
shared float squares[256];
void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    float sum = 0.0; float square = 0.0;
    for (uint column = lane; column < p.hidden; column += 256) {
        uint index = row * p.hidden + column;
        float value = projected.values[index] + float(bias_values.values[column]) + float(residual.values[index]);
        sum += value; square += value * value;
    }
    sums[lane] = sum; squares[lane] = square; barrier();
    for (uint step = 128; step > 0; step >>= 1) { if (lane < step) { sums[lane] += sums[lane + step]; squares[lane] += squares[lane + step]; } barrier(); }
    float mean = sums[0] / float(p.hidden);
    float variance = max(squares[0] / float(p.hidden) - mean * mean, 0.0);
    float inverse = inversesqrt(variance + p.epsilon);
    for (uint column = lane; column < p.hidden; column += 256) {
        uint index = row * p.hidden + column;
        float value = projected.values[index] + float(bias_values.values[column]) + float(residual.values[index]);
        output_values.values[index] = float16_t((value - mean) * inverse * weight_values.values[column] + norm_bias.values[column]);
    }
}
