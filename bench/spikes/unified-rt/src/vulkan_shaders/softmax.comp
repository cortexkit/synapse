#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require
layout(local_size_x = 256) in;
layout(set=0,binding=0,scalar) readonly buffer Scores { float values[]; } scores;
layout(set=0,binding=1,scalar) readonly buffer Mask { uint values[]; } mask;
layout(set=0,binding=2,scalar) writeonly buffer Output { float16_t values[]; } output_values;
layout(push_constant) uniform Params { uint batch; uint heads; uint seq; float scale; } p;
shared float reduced[256];
void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    uint batch = row / (p.heads * p.seq);
    float maximum = -3.402823e38;
    for (uint column = lane; column < p.seq; column += 256) {
        float value = mask.values[batch * p.seq + column] != 0 ? scores.values[row * p.seq + column] * p.scale : -10000.0;
        maximum = max(maximum, value);
    }
    reduced[lane] = maximum; barrier();
    for (uint step = 128; step > 0; step >>= 1) { if (lane < step) reduced[lane] = max(reduced[lane], reduced[lane + step]); barrier(); }
    maximum = reduced[0];
    float sum = 0.0;
    for (uint column = lane; column < p.seq; column += 256) {
        float value = mask.values[batch * p.seq + column] != 0 ? scores.values[row * p.seq + column] * p.scale : -10000.0;
        sum += exp(value - maximum);
    }
    reduced[lane] = sum; barrier();
    for (uint step = 128; step > 0; step >>= 1) { if (lane < step) reduced[lane] += reduced[lane + step]; barrier(); }
    float inverse = 1.0 / max(reduced[0], 1e-20);
    for (uint column = lane; column < p.seq; column += 256) {
        float value = mask.values[batch * p.seq + column] != 0 ? scores.values[row * p.seq + column] * p.scale : -10000.0;
        output_values.values[row * p.seq + column] = float16_t(exp(value - maximum) * inverse);
    }
}
