    "approval_policy_family_change": "requires explicit migration or re-approval",
    "runtime_rewrite": "forbidden; runtime never rewrites evidence_requirements_revision",
    "migration_seed": "uses the initial approval policy revision and does not carry concrete evidence"
  },
  "gate_completeness": {
    "required_ids": ["G-DEC-01", "G-DEC-02", "G-DEC-03", "G-DEC-04", "G-DEC-05", "G-DEC-06", "G-DEC-07", "G-DEC-08", "G-DEC-09", "G-DEC-10", "G-DEC-11", "G-DEC-12"],
    "multiplicity": "exactly one passed entry per exact ID",
    "matching": "ID equality, status equality, manifest revision equality; substring-only matches are invalid"
  }
