  "initial_revisions": {
    "approval_policy": "owned-decode-evidence-requirements-v1",
    "cert_row_evidence_schema": "owned-decode-cert-evidence-v1",
    "g_dec_manifest_family": "decode-fixture-registry-v1",
    "g_dec_manifest_revision": "decode-fixture-registry-v1"
  },
  "compiled_compatibility_map": [
    {
      "approval_evidence_requirements_revision": "owned-decode-evidence-requirements-v1",
      "accepted_cert_row_evidence_schema_revisions": ["owned-decode-cert-evidence-v1"],
      "required_g_dec_manifest_families": ["decode-fixture-registry-v1"],
      "accepted_g_dec_manifest_revisions": ["decode-fixture-registry-v1"],
      "current_certification_compatible": true
