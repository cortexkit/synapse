{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Direct ANE development stress measurement",
  "type": "object",
  "required": ["schema", "kind", "source_commit", "machine", "os", "load_1_5_15_start", "load_1_5_15_end", "request_count", "completed_count", "request_errors", "sample_count", "samples", "max_resident_per_model", "max_resident_total", "admitted_count", "evicted_count", "shape_not_admitted_count", "leased_evict_count", "no_ane_resources", "ane_lane_busy", "metal_ranking_check", "reranker_pool_check"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "development"},
    "source_commit": {"type": "string", "minLength": 40, "maxLength": 40},
    "machine": {"type": "object", "required": ["model_identifier", "platform_uuid"], "properties": {"model_identifier": {"type": "string", "minLength": 1}, "platform_uuid": {"type": "string", "minLength": 1}}},
    "os": {"type": "object", "required": ["version", "build"], "properties": {"version": {"type": "string", "minLength": 1}, "build": {"type": "string", "minLength": 1}}},
    "load_1_5_15_start": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}},
    "load_1_5_15_end": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}},
    "request_count": {"type": "integer", "const": 37},
    "completed_count": {"type": "integer", "minimum": 0},
    "request_errors": {"type": "array", "items": {"type": "string"}},
    "sample_count": {"type": "integer", "minimum": 0},
    "samples": {"type": "array", "items": {"type": "object", "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "enum": [128, 256, 512, 1024, 2048, 4096, 8192]}}}},
    "max_resident_per_model": {"type": "integer", "minimum": 0},
    "max_resident_total": {"type": "integer", "minimum": 0},
    "admitted_count": {"type": "integer", "minimum": 0},
    "evicted_count": {"type": "integer", "minimum": 0},
    "shape_not_admitted_count": {"type": "integer", "minimum": 0},
    "leased_evict_count": {"type": "integer", "minimum": 0},
    "no_ane_resources": {"type": "object", "required": ["count"], "properties": {"count": {"type": "integer", "minimum": 0}}},
    "ane_lane_busy": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}}},
    "metal_ranking_check": {"type": "object", "required": ["status", "reason"], "properties": {"status": {"type": "string", "enum": ["passed", "skipped"]}, "reason": {"type": "string"}}},
    "reranker_pool_check": {"type": "object", "required": ["finite", "byte_identical_repeats"], "properties": {"finite": {"type": "string", "enum": ["passed", "failed"]}, "byte_identical_repeats": {"type": "string", "enum": ["passed", "failed"]}, "scores_by_rung": {"type": "array", "items": {"type": "object", "required": ["shape", "score"], "properties": {"shape": {"type": "integer", "enum": [128, 512, 2048]}, "score": {"type": "number"}}}}}}
  }
}
